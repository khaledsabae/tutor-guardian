<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (android:fullBackupContent).

  Android Auto Backup uploads the app's internal storage to the user's Google
  Drive by default. The privacy screen promises that a parent's recorded voice
  never leaves the device — and until this file existed, that promise was
  false: `narrations/` sits in the app's files directory and was being backed
  up with everything else.

  A recording of a parent reading to their child is the most personal thing
  this app holds. It is excluded here, and `data_extraction_rules.xml` does
  the same for Android 12+, which ignores this file entirely.

  WHERE it lives matters (PR #36 review, item 10). NarrationStore writes under
  path_provider's getApplicationDocumentsDirectory(), which on Android is
  Context.getDir("flutter") = <data dir>/app_flutter — the "root" domain, not
  "file" (getFilesDir() = <data dir>/files). The rule that named domain="file"
  matched nothing, and the recordings went to Google Drive anyway. The "file"
  rule stays only as a guard should the folder ever move there; the "root"
  rule is the one that holds today. test/backup_rules_test.dart pins both
  against NarrationStore.
-->
<full-backup-content>
    <exclude domain="root" path="app_flutter/narrations/" />
    <exclude domain="file" path="narrations/" />
    <!-- The child-mode PIN and tokens live in EncryptedSharedPreferences;
         restoring them onto a different device would carry a family's lock
         to a phone their child might be holding, and restoring them without
         the hardware Keystore keys leads to BadPaddingException. -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
