#!/usr/bin/env bash
# pre-commit — يمنع commit فيه drift في قاعدة المعرفة.
# تفعيل لمرة واحدة:  git config core.hooksPath .githooks
#
# يشغّل الفحص السريع فقط (schema/enum/taxonomy) عشان يفضل سريع.
# فحص ChromaDB الكامل بيشتغل في الـ CI (وعبر ./check.sh --full).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

PY="backend/.venv/bin/python"
[ -x "$PY" ] || PY=".venv/bin/python"
[ -x "$PY" ] || PY="python3"

echo ""
echo "🔍 [pre-commit] Knowledge-base integrity check..."
if "$PY" ops/tools/check_kb_integrity.py; then
    echo "✅ [pre-commit] KB in sync."
else
    echo ""
    echo "❌ [pre-commit] DRIFT DETECTED — commit blocked."
    echo "   Fix: backend/.venv/bin/python ops/tools/normalize_units.py"
    echo "        backend/.venv/bin/python ops/tools/build_vector_db.py"
    echo "   Bypass (discouraged): git commit --no-verify"
    echo ""
    exit 1
fi

# القرآن — الأذكار بتخرج إشعارات يومية، فكلمة محرَّفة تعني آية مغلوطة تصل كل
# مستخدم. أول تشغيلة مسكت «لِلَّذِينِ» مكان «لِلدِّينِ» في الروم ٣٠، وكانت شغّالة
# في الإنتاج. ده الفحص الوحيد هنا اللي مايتخطّاش بـ--no-verify عن طيب خاطر.
echo "🔍 [pre-commit] فحص مطابقة الآيات للمصحف..."
if "$PY" ops/tools/check_quran_citations.py; then
    :
else
    echo ""
    echo "❌ [pre-commit] آية لا تطابق المصحف — commit متوقف."
    echo "   صحّح النص في mobile/lib/features/adhkar/data/family_adhkar.dart"
    echo ""
    exit 1
fi

# القرآن بالإنجليزية — سؤال مختلف تمامًا عن اللي فوق. الفحص السابق بيسأل «هل
# الآية مطابقة للمصحف؟»، وده بيسأل «هل فيه إنجليزية مقدَّمة على أنها قرآن؟».
# القرآن لا يُترجَم: اللي يُكتب بالإنجليزية مقابل آية هو تفسير لمعناها لا القرآن،
# وتقديمه على أنه القرآن خطأ شرعي لا خيار أسلوبي. المنهج الإنجليزي نضيف اليوم
# (٤٢٤ ملفًا)، والفحص موضوع الآن عشان يفضل نضيف لما تُترجَم طبقة الأذكار
# (١٤٢ آية) — لا بعد ما تنزل.
echo "🔍 [pre-commit] فحص عرض القرآن في المحتوى الإنجليزي..."
"$PY" ops/tools/check_quran_rendering.py
_qr=$?
if [ $_qr -eq 2 ]; then
    echo ""
    echo "⛔ [pre-commit] self-tests بتاعة فحص عرض القرآن فشلت — الفحص لاغٍ."
    echo "   نجاح كاذب على نصّ شرعي أسوأ من غياب الفحص. صلّح الفحص لا تتخطّاه."
    echo ""
    exit 1
elif [ $_qr -ne 0 ]; then
    echo ""
    echo "❌ [pre-commit] إنجليزية مقدَّمة على أنها قرآن — commit متوقف."
    echo "   اترك الآية بالعربية، واكتب المعنى مُعلَنًا:"
    echo "      \"interpretation of the meaning: …\"  أو  provenance: <ترجمة معتمدة>"
    echo ""
    exit 1
fi

# حشو الأذكار — نفس الملف، عطب مختلف: نص واحد مكرر ٢٢٣ مرة بعدّاد ظاهر
# وإسناد موحّد مختلَق. فحص القرآن فوق ما كانش هيشوفه لأن المكرر مش آية.
echo "🔍 [pre-commit] فحص أصالة محتوى الإشعارات..."
if "$PY" ops/tools/check_adhkar_integrity.py; then
    :
else
    echo ""
    echo "❌ [pre-commit] محتوى محشوّ أو منسوب بلا سند — commit متوقف."
    echo ""
    exit 1
fi

# الأحاديث — على الصحيحين وحدهما، فسؤال الدرجة يسقط ويبقى اللفظ والرقم، وهما آليّان.
# مستخدمان بلّغا عن اللفظ المحرَّف يومي ٣ و٧ أغسطس ٢٠٢٦ ومحدش شاف بلاغهم.
echo "🔍 [pre-commit] فحص الأحاديث على الصحيحين..."
if "$PY" ops/tools/check_hadith_citations.py; then
    :
else
    echo ""
    echo "❌ [pre-commit] حديث لا يطابق الصحيحين — commit متوقف."
    echo "   الصيغة المطلوبة: source: 'صحيح البخاري — حديث ٥٠٢٧'"
    echo ""
    exit 1
fi

# ruff — أربع قواعد بتمسك باج مش أسلوب (السبب مكتوب في pyproject.toml).
# نفس الأمر بيشتغل في workflow «Backend tests»؛ هنا عشان الرد يبقى فوري وبلا
# شبكة، وهناك عشان يمسك اللي اتخطّى بـ--no-verify أو اتدفع من جهاز تاني.
# أول تشغيلة لـruff مسكت اسم غير معرّف ومفتاح مكرر في dict — الاتنين كانوا
# في الطريق للإنتاج.
RUFF=""
for candidate in "$HOME/.local/bin/ruff" "$(command -v ruff || true)"; do
    [ -x "$candidate" ] && RUFF="$candidate" && break
done
if [ -z "$RUFF" ]; then
    echo "⚠️  [pre-commit] ruff غير مثبّت — تخطّي فحص اللينت (pip install --user ruff)."
    echo "✅ [pre-commit] committing."
else
    echo "🔍 [pre-commit] ruff..."
    if "$RUFF" check backend/ ops/ scripts/; then
        echo "✅ [pre-commit] ruff نضيف — committing."
    else
        echo ""
        echo "❌ [pre-commit] ruff رصد مشكلة — commit متوقف."
        echo "   معظمها بتتصلح آليًا: ruff check --fix backend/ ops/ scripts/"
        echo "   تخطّي (غير محبّذ): git commit --no-verify"
        echo ""
        exit 1
    fi
fi
