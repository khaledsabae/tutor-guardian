{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutor-guardian.local/schemas/curriculum/mission_bank.schema.json",
  "title": "Off-screen Mission Bank",
  "description": "بنك مهام خارج الشاشة لفئة عمرية واحدة: missions_<age_band>.json. شُحن في سبرنت ٢ بلا مخطّط وبلا فحص. ملاحظة: عتبة الرافعة (estimated_minutes ≥ ١٥) يفرضها child_missions.load_missions بالترشيح لا بالرفض — مهمة أقصر لا تُحمَّل ولا تُشتكى، فالمخطّط يفرضها هنا صراحةً حتى لا تختفي بصمت.",
  "type": "object",
  "additionalProperties": false,
  "required": ["age_band", "version", "is_published", "missions"],
  "properties": {
    "age_band": {
      "type": "string",
      "enum": ["4-6", "7-9", "10-12", "13-15", "16-18"]
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "is_published": { "type": "boolean" },
    "description": { "type": "string" },
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_ar", "instruction_ar", "estimated_minutes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "domain": { "type": "string" },
          "source_unit_id": { "type": ["string", "null"] },
          "title_ar": { "type": "string", "minLength": 3 },
          "instruction_ar": { "type": "string", "minLength": 10 },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 15,
            "description": "معامل الرافعة: بطاقة الشاشة ثلاث دقائق، وخمسة أضعافها خمس عشرة. أقلّ من ذلك يجعل الرقم الذي تعرضه لوحة الوالد بلا معنى."
          },
          "needs_parent": { "type": "boolean" },
          "needs_outdoors": { "type": "boolean" },
          "materials": { "type": "array", "items": { "type": "string" } },
          "skill": { "type": "string" },
          "linked_challenge": { "type": ["string", "null"] },
          "is_published": { "type": "boolean" }
        }
      }
    }
  }
}
