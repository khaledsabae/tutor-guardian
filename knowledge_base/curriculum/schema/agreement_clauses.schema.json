{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tutor-guardian.local/schemas/curriculum/agreement_clauses.schema.json",
  "title": "Family Agreement Clause Bank",
  "description": "بنك بنود الميثاق لفئة عمرية واحدة: clauses_<age_band>.json. شُحن هذا البنك في سبرنت ٢ بلا مخطّط وبلا فحص pre-commit — وهو البنك الذي يقرّر ما يوقّعه طفل. المخطّط أُضيف مع بنك الرخصة سدًّا لذلك الدَّين.",
  "type": "object",
  "additionalProperties": false,
  "required": ["age_band", "version", "is_published", "pairs"],
  "properties": {
    "age_band": {
      "type": "string",
      "enum": ["4-6", "7-9", "10-12", "13-15", "16-18"]
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "is_published": { "type": "boolean" },
    "description": { "type": "string" },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "child", "parent"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "child": {
            "type": "string",
            "minLength": 5,
            "description": "البند على الطفل."
          },
          "parent": {
            "type": "string",
            "minLength": 5,
            "description": "البند المقابل على الوالد. الاقتران إلزامي بالبنية لا بالمراجعة: اتفاقٌ كل بنوده تشير إلى الطفل قائمةُ أوامر، والبحث الذي تقوم عليه الميزة عن اتفاق."
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
