{
  "group": "teen",
  "age_bands": [
    "13-15",
    "16-18"
  ],
  "version": "1.0.0",
  "is_published": true,
  "description": "خطة الأسبوع من ثلاث عشرة سنة إلى ثماني عشرة: الصلاة بقناعة، والخلاف باحترام، والدراسة والمستقبل، والشاشات، والنوم، والقلق، والإخوة.",
  "topics": [
    {
      "key": "prayer",
      "focus": "الصلاة بقناعة: حوار لا أوامر",
      "actions": [
        {
          "key": "prayer_teen_1",
          "text": "اسأله عن علاقته بالصلاة بهدوء، واستمع دون لوم أو مقاطعة."
        },
        {
          "key": "prayer_teen_2",
          "text": "صلِّ معه صلاةً واحدة في المسجد أو البيت هذا الأسبوع، واجعلها وقتًا خاصًا بينكما."
        },
        {
          "key": "prayer_teen_3",
          "text": "شاركه بصدق شيئًا تجده في صلاتك أنت، دون وعظ طويل."
        },
        {
          "key": "prayer_teen_4",
          "text": "إن كانت لديه أسئلة دينية فلا تغضب؛ ابحثا معًا عن جوابها عند مصدر موثوق."
        }
      ],
      "lessons": {
        "13-15": [
          "lesson_13-15_islamic_mockery_01",
          "lesson_13-15_islamic_parenting_teen_identity_02"
        ],
        "16-18": [
          "lesson_16-18_islamic_parenting_adult_faith_01",
          "lesson_16-18_aqeedah_conviction_02"
        ]
      }
    },
    {
      "key": "anger",
      "focus": "الخلاف والغضب: احترام متبادل",
      "actions": [
        {
          "key": "anger_teen_1",
          "text": "اتفقا على تأجيل النقاش الحاد حتى يهدأ الطرفان، ثم عودا إليه."
        },
        {
          "key": "anger_teen_2",
          "text": "استمع لوجهة نظره كاملة قبل الرد، وأعد صياغتها ليشعر أنك فهمته."
        },
        {
          "key": "anger_teen_3",
          "text": "تجنّب الإهانة والسخرية أثناء الخلاف، واعتذر إن أخطأت."
        },
        {
          "key": "anger_teen_4",
          "text": "أعطه مساحة قرار في أمر يخصّه هذا الأسبوع، مع حدود واضحة."
        }
      ],
      "lessons": {
        "13-15": [
          "lesson_13-15_development_brain_identity_02",
          "lesson_13-15_development_brain_identity_b04"
        ],
        "16-18": [
          "lesson_16-18_development_adult_readiness_01",
          "lesson_16-18_islamic_independence_boundaries_01"
        ]
      }
    },
    {
      "key": "study",
      "focus": "الدراسة والمستقبل: هدف واضح",
      "actions": [
        {
          "key": "study_teen_1",
          "text": "اجلس معه ليضع خطة أسبوعية واقعية للمذاكرة يكتبها هو بنفسه."
        },
        {
          "key": "study_teen_2",
          "text": "اسأله عن المادة الأصعب عليه، وابحثا معًا عن مساعدة مناسبة."
        },
        {
          "key": "study_teen_3",
          "text": "تحدّثا عن هدف بعيد يحبه، واربطا به خطوة صغيرة هذا الأسبوع."
        },
        {
          "key": "study_teen_4",
          "text": "امدح انضباطه وجهده، وتجنّب مقارنته بأقرانه."
        }
      ],
      "lessons": {
        "13-15": [
          "lesson_13-15_development_brain_identity_03"
        ],
        "16-18": [
          "lesson_16-18_development_major_choice_01",
          "lesson_16-18_development_adult_readiness_02"
        ]
      }
    },
    {
      "key": "screens",
      "focus": "توازن الشاشة بثقة ومسؤولية",
      "actions": [
        {
          "key": "screens_teen_1",
          "text": "اتفقا معًا على حدود للهاتف: وقت النوم، وأوقات الدراسة، والوجبات."
        },
        {
          "key": "screens_teen_2",
          "text": "اسأله عمّا يتابعه على الإنترنت بفضول لا بتحقيق."
        },
        {
          "key": "screens_teen_3",
          "text": "كن قدوة: ضع هاتفك جانبًا في الوجبات والحديث العائلي."
        },
        {
          "key": "screens_teen_4",
          "text": "اقترح نشاطًا مشتركًا بلا شاشات مرة هذا الأسبوع: رياضة أو مشي أو عمل تطوعي."
        }
      ],
      "lessons": {
        "13-15": [
          "lesson_13-15_cyber_digital_maturity_03",
          "lesson_13-15_islamic_parenting_steadfast_02"
        ],
        "16-18": [
          "lesson_16-18_cyber_digital_professional_b04"
        ]
      }
    },
    {
      "key": "sleep",
      "focus": "نوم كافٍ في سنوات المراهقة",
      "actions": [
        {
          "key": "sleep_teen_1",
          "text": "اتفقا على ساعة لإطفاء الأجهزة ليلًا، على أن يُشحن الهاتف خارج الغرفة."
        },
        {
          "key": "sleep_teen_2",
          "text": "شجّعه على موعد استيقاظ ثابت أو قريب منه في كل الأيام."
        },
        {
          "key": "sleep_teen_3",
          "text": "تحدّث معه عن أثر السهر في المزاج والتركيز، دون محاضرة."
        },
        {
          "key": "sleep_teen_4",
          "text": "خفّف المنبّهات مثل القهوة ومشروبات الطاقة في المساء."
        }
      ],
      "lessons": {
        "13-15": [
          "lesson_13-15_cyber_digital_maturity_03"
        ],
        "16-18": [
          "lesson_16-18_medical_precollege_wellbeing_01"
        ]
      }
    },
    {
      "key": "fear",
      "focus": "القلق وضغط الحياة: لست وحدك",
      "actions": [
        {
          "key": "fear_teen_1",
          "text": "خصّص وقتًا أسبوعيًا للحديث معه بلا هواتف، واسأله عمّا يشغل باله."
        },
        {
          "key": "fear_teen_2",
          "text": "تقبّل مشاعره دون تهوين: «يبدو أن هذا يضغط عليك كثيرًا»."
        },
        {
          "key": "fear_teen_3",
          "text": "ساعده على تقسيم المشكلة الكبيرة إلى خطوات صغيرة."
        },
        {
          "key": "fear_teen_4",
          "text": "إن لاحظت حزنًا أو انعزالًا يستمر أسبوعين أو أكثر، فاستشر مختصًا."
        }
      ],
      "lessons": {
        "13-15": [
          "lesson_13-15_medical_mental_health_01"
        ],
        "16-18": [
          "lesson_16-18_development_adult_readiness_03",
          "lesson_16-18_medical_adult_transition_b04"
        ]
      }
    },
    {
      "key": "siblings",
      "focus": "علاقة الإخوة في سن المراهقة",
      "actions": [
        {
          "key": "siblings_teen_1",
          "text": "احترم خصوصيته أمام إخوته، ولا تنتقده أمامهم."
        },
        {
          "key": "siblings_teen_2",
          "text": "أعطه دورًا قياديًا مع إخوته الأصغر في مهمة محددة، وامدح أداءه."
        },
        {
          "key": "siblings_teen_3",
          "text": "تجنّب المقارنة بينه وبين إخوته في الدراسة أو السلوك."
        },
        {
          "key": "siblings_teen_4",
          "text": "خصّص وقتًا منفردًا معه بعيدًا عن إخوته هذا الأسبوع."
        }
      ],
      "lessons": {
        "13-15": [
          "lesson_13-15_development_brain_identity_b04"
        ],
        "16-18": [
          "lesson_16-18_development_adult_readiness_04"
        ]
      }
    }
  ],
  "worship": [
    {
      "key": "worship_teen_1",
      "text": "صلّوا صلاةً واحدة جماعةً في البيت كل يوم هذا الأسبوع."
    },
    {
      "key": "worship_teen_2",
      "text": "اطلبوا من ابنكم أو ابنتكم اختيار عمل تطوعي تشاركون فيه معًا."
    },
    {
      "key": "worship_teen_3",
      "text": "اجلسوا مرة هذا الأسبوع لقراءة تفسير آية يختارها هو من كتاب تفسير موثوق."
    },
    {
      "key": "worship_teen_4",
      "text": "اقرؤوا معًا صفحتين من القرآن في يوم الجمعة."
    },
    {
      "key": "worship_teen_5",
      "text": "ادعوا معًا لكل فرد من الأسرة باسمه بعد إحدى الصلوات هذا الأسبوع."
    },
    {
      "key": "worship_teen_6",
      "text": "تصدّقوا معًا، ودعوه يختار الجهة التي تذهب إليها الصدقة."
    }
  ]
}
